<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Payment Method Facade configuration -->
    <virtualType name="PaypercutFacade" type="Magento\Payment\Model\Method\Adapter">
        <arguments>
            <argument name="code" xsi:type="const">\Paypercut\Payment\Model\Ui\ConfigProvider::CODE</argument>
            <argument name="formBlockType" xsi:type="string">Magento\Payment\Block\Form</argument>
            <argument name="infoBlockType" xsi:type="string">Paypercut\Payment\Block\Info</argument>
            <argument name="valueHandlerPool" xsi:type="object">PaypercutValueHandlerPool</argument>
            <argument name="commandPool" xsi:type="object">PaypercutCommandPool</argument>
            <argument name="validatorPool" xsi:type="object">PaypercutValidatorPool</argument>
        </arguments>
    </virtualType>

    <!-- Configuration reader -->
    <virtualType name="PaypercutConfig" type="Magento\Payment\Gateway\Config\Config">
        <arguments>
            <argument name="methodCode" xsi:type="const">\Paypercut\Payment\Model\Ui\ConfigProvider::CODE</argument>
        </arguments>
    </virtualType>

    <!-- Logger -->
    <virtualType name="PaypercutLogger" type="Magento\Payment\Model\Method\Logger">
        <arguments>
            <argument name="config" xsi:type="object">PaypercutConfig</argument>
        </arguments>
    </virtualType>

    <type name="Paypercut\Payment\Gateway\Http\Client\TransactionClient">
        <arguments>
            <argument name="logger" xsi:type="object">PaypercutLogger</argument>
            <argument name="config" xsi:type="object">PaypercutConfig</argument>
        </arguments>
    </type>

    <!-- Commands infrastructure -->
    <virtualType name="PaypercutCommandPool" type="Magento\Payment\Gateway\Command\CommandPool">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="authorize" xsi:type="string">PaypercutAuthorizeCommand</item>
                <item name="capture" xsi:type="string">PaypercutCaptureCommand</item>
                <item name="void" xsi:type="string">PaypercutVoidCommand</item>
                <item name="refund" xsi:type="string">PaypercutRefundCommand</item>
                <item name="cancel" xsi:type="string">PaypercutVoidCommand</item>
                <item name="vault_authorize" xsi:type="string">PaypercutVaultAuthorizeCommand</item>
                <item name="vault_capture" xsi:type="string">PaypercutVaultCaptureCommand</item>
            </argument>
        </arguments>
    </virtualType>

    <!-- Authorize command -->
    <virtualType name="PaypercutAuthorizeCommand" type="Magento\Payment\Gateway\Command\GatewayCommand">
        <arguments>
            <argument name="requestBuilder" xsi:type="object">PaypercutAuthorizationRequest</argument>
            <argument name="handler" xsi:type="object">PaypercutAuthorizationHandler</argument>
            <argument name="transferFactory" xsi:type="object">Paypercut\Payment\Gateway\Http\TransferFactory</argument>
            <argument name="validator" xsi:type="object">Paypercut\Payment\Gateway\Validator\ResponseCodeValidator</argument>
            <argument name="client" xsi:type="object">Paypercut\Payment\Gateway\Http\Client\TransactionClient</argument>
        </arguments>
    </virtualType>

    <!-- Authorization Request -->
    <virtualType name="PaypercutAuthorizationRequest" type="Magento\Payment\Gateway\Request\BuilderComposite">
        <arguments>
            <argument name="builders" xsi:type="array">
                <item name="transaction" xsi:type="string">Paypercut\Payment\Gateway\Request\AuthorizationRequest</item>
                <item name="vault" xsi:type="string">Paypercut\Payment\Gateway\Request\VaultDataBuilder</item>
            </argument>
        </arguments>
    </virtualType>

    <type name="Paypercut\Payment\Gateway\Request\AuthorizationRequest">
        <arguments>
            <argument name="config" xsi:type="object">PaypercutConfig</argument>
        </arguments>
    </type>

    <!-- Authorization Handler -->
    <virtualType name="PaypercutAuthorizationHandler" type="Magento\Payment\Gateway\Response\HandlerChain">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="txnid" xsi:type="string">Paypercut\Payment\Gateway\Response\TxnIdHandler</item>
                <item name="vault" xsi:type="string">Paypercut\Payment\Gateway\Response\VaultDetailsHandler</item>
            </argument>
        </arguments>
    </virtualType>

    <!-- Capture command -->
    <virtualType name="PaypercutCaptureCommand" type="Magento\Payment\Gateway\Command\GatewayCommand">
        <arguments>
            <argument name="requestBuilder" xsi:type="object">Paypercut\Payment\Gateway\Request\CaptureRequest</argument>
            <argument name="handler" xsi:type="object">Paypercut\Payment\Gateway\Response\TxnIdHandler</argument>
            <argument name="transferFactory" xsi:type="object">Paypercut\Payment\Gateway\Http\TransferFactory</argument>
            <argument name="validator" xsi:type="object">Paypercut\Payment\Gateway\Validator\ResponseCodeValidator</argument>
            <argument name="client" xsi:type="object">Paypercut\Payment\Gateway\Http\Client\TransactionClient</argument>
        </arguments>
    </virtualType>

    <type name="Paypercut\Payment\Gateway\Request\CaptureRequest">
        <arguments>
            <argument name="config" xsi:type="object">PaypercutConfig</argument>
        </arguments>
    </type>

    <!-- Void command -->
    <virtualType name="PaypercutVoidCommand" type="Magento\Payment\Gateway\Command\GatewayCommand">
        <arguments>
            <argument name="requestBuilder" xsi:type="object">Paypercut\Payment\Gateway\Request\VoidRequest</argument>
            <argument name="handler" xsi:type="object">Paypercut\Payment\Gateway\Response\TxnIdHandler</argument>
            <argument name="transferFactory" xsi:type="object">Paypercut\Payment\Gateway\Http\TransferFactory</argument>
            <argument name="validator" xsi:type="object">Paypercut\Payment\Gateway\Validator\ResponseCodeValidator</argument>
            <argument name="client" xsi:type="object">Paypercut\Payment\Gateway\Http\Client\TransactionClient</argument>
        </arguments>
    </virtualType>

    <type name="Paypercut\Payment\Gateway\Request\VoidRequest">
        <arguments>
            <argument name="config" xsi:type="object">PaypercutConfig</argument>
        </arguments>
    </type>

    <!-- Refund command -->
    <virtualType name="PaypercutRefundCommand" type="Magento\Payment\Gateway\Command\GatewayCommand">
        <arguments>
            <argument name="requestBuilder" xsi:type="object">Paypercut\Payment\Gateway\Request\RefundRequest</argument>
            <argument name="handler" xsi:type="object">Paypercut\Payment\Gateway\Response\TxnIdHandler</argument>
            <argument name="transferFactory" xsi:type="object">Paypercut\Payment\Gateway\Http\TransferFactory</argument>
            <argument name="validator" xsi:type="object">Paypercut\Payment\Gateway\Validator\ResponseCodeValidator</argument>
            <argument name="client" xsi:type="object">Paypercut\Payment\Gateway\Http\Client\TransactionClient</argument>
        </arguments>
    </virtualType>

    <type name="Paypercut\Payment\Gateway\Request\RefundRequest">
        <arguments>
            <argument name="config" xsi:type="object">PaypercutConfig</argument>
        </arguments>
    </type>

    <!-- Validators -->
    <virtualType name="PaypercutValidatorPool" type="Magento\Payment\Gateway\Validator\ValidatorPool">
        <arguments>
            <argument name="validators" xsi:type="array">
                <item name="country" xsi:type="string">PaypercutCountryValidator</item>
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="PaypercutCountryValidator" type="Magento\Payment\Gateway\Validator\CountryValidator">
        <arguments>
            <argument name="config" xsi:type="object">PaypercutConfig</argument>
        </arguments>
    </virtualType>

    <!-- Value handlers infrastructure -->
    <virtualType name="PaypercutValueHandlerPool" type="Magento\Payment\Gateway\Config\ValueHandlerPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="default" xsi:type="string">PaypercutConfigValueHandler</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="PaypercutConfigValueHandler" type="Magento\Payment\Gateway\Config\ConfigValueHandler">
        <arguments>
            <argument name="configInterface" xsi:type="object">PaypercutConfig</argument>
        </arguments>
    </virtualType>

    <type name="Paypercut\Payment\Block\Info">
        <arguments>
            <argument name="config" xsi:type="object">PaypercutConfig</argument>
        </arguments>
    </type>

    <!-- ==================== VAULT (SAVED CARDS) ==================== -->

    <virtualType name="PaypercutVaultFacade" type="Magento\Vault\Model\Method\Vault">
        <arguments>
            <argument name="config" xsi:type="object">PaypercutVaultPaymentConfig</argument>
            <argument name="valueHandlerPool" xsi:type="object">PaypercutVaultValueHandlerPool</argument>
            <argument name="vaultProvider" xsi:type="object">PaypercutFacade</argument>
            <argument name="code" xsi:type="const">Paypercut\Payment\Model\Ui\ConfigProvider::VAULT_CODE</argument>
        </arguments>
    </virtualType>

    <virtualType name="PaypercutVaultPaymentConfig" type="Magento\Payment\Gateway\Config\Config">
        <arguments>
            <argument name="methodCode" xsi:type="const">Paypercut\Payment\Model\Ui\ConfigProvider::VAULT_CODE</argument>
        </arguments>
    </virtualType>

    <virtualType name="PaypercutVaultValueHandlerPool" type="Magento\Payment\Gateway\Config\ValueHandlerPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="default" xsi:type="string">PaypercutVaultConfigValueHandler</item>
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="PaypercutVaultConfigValueHandler" type="Magento\Payment\Gateway\Config\ConfigValueHandler">
        <arguments>
            <argument name="configInterface" xsi:type="object">PaypercutVaultPaymentConfig</argument>
        </arguments>
    </virtualType>

    <!-- Vault Authorize Command -->
    <virtualType name="PaypercutVaultAuthorizeCommand" type="Magento\Payment\Gateway\Command\GatewayCommand">
        <arguments>
            <argument name="requestBuilder" xsi:type="object">PaypercutVaultAuthorizationRequest</argument>
            <argument name="handler" xsi:type="object">Paypercut\Payment\Gateway\Response\TxnIdHandler</argument>
            <argument name="transferFactory" xsi:type="object">Paypercut\Payment\Gateway\Http\TransferFactory</argument>
            <argument name="validator" xsi:type="object">Paypercut\Payment\Gateway\Validator\ResponseCodeValidator</argument>
            <argument name="client" xsi:type="object">Paypercut\Payment\Gateway\Http\Client\TransactionClient</argument>
        </arguments>
    </virtualType>

    <virtualType name="PaypercutVaultAuthorizationRequest" type="Magento\Payment\Gateway\Request\BuilderComposite">
        <arguments>
            <argument name="builders" xsi:type="array">
                <item name="transaction" xsi:type="string">Paypercut\Payment\Gateway\Request\AuthorizationRequest</item>
                <item name="token" xsi:type="string">Paypercut\Payment\Gateway\Request\TokenDataBuilder</item>
            </argument>
        </arguments>
    </virtualType>

    <!-- Vault Capture Command -->
    <virtualType name="PaypercutVaultCaptureCommand" type="Magento\Payment\Gateway\Command\GatewayCommand">
        <arguments>
            <argument name="requestBuilder" xsi:type="object">PaypercutVaultCaptureRequest</argument>
            <argument name="handler" xsi:type="object">Paypercut\Payment\Gateway\Response\TxnIdHandler</argument>
            <argument name="transferFactory" xsi:type="object">Paypercut\Payment\Gateway\Http\TransferFactory</argument>
            <argument name="validator" xsi:type="object">Paypercut\Payment\Gateway\Validator\ResponseCodeValidator</argument>
            <argument name="client" xsi:type="object">Paypercut\Payment\Gateway\Http\Client\TransactionClient</argument>
        </arguments>
    </virtualType>

    <virtualType name="PaypercutVaultCaptureRequest" type="Magento\Payment\Gateway\Request\BuilderComposite">
        <arguments>
            <argument name="builders" xsi:type="array">
                <item name="capture" xsi:type="string">Paypercut\Payment\Gateway\Request\CaptureRequest</item>
                <item name="token" xsi:type="string">Paypercut\Payment\Gateway\Request\TokenDataBuilder</item>
            </argument>
        </arguments>
    </virtualType>

    <!-- ==================== BNPL PAYMENT METHOD ==================== -->

    <virtualType name="PaypercutBnplFacade" type="Magento\Payment\Model\Method\Adapter">
        <arguments>
            <argument name="code" xsi:type="const">\Paypercut\Payment\Model\Ui\BnplConfigProvider::CODE</argument>
            <argument name="formBlockType" xsi:type="string">Magento\Payment\Block\Form</argument>
            <argument name="infoBlockType" xsi:type="string">Paypercut\Payment\Block\BnplInfo</argument>
            <argument name="valueHandlerPool" xsi:type="object">PaypercutBnplValueHandlerPool</argument>
            <argument name="commandPool" xsi:type="object">PaypercutBnplCommandPool</argument>
            <argument name="validatorPool" xsi:type="object">PaypercutBnplValidatorPool</argument>
        </arguments>
    </virtualType>

    <virtualType name="PaypercutBnplConfig" type="Magento\Payment\Gateway\Config\Config">
        <arguments>
            <argument name="methodCode" xsi:type="const">\Paypercut\Payment\Model\Ui\BnplConfigProvider::CODE</argument>
        </arguments>
    </virtualType>

    <!-- BNPL Commands -->
    <virtualType name="PaypercutBnplCommandPool" type="Magento\Payment\Gateway\Command\CommandPool">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="authorize" xsi:type="string">PaypercutBnplAuthorizeCommand</item>
                <item name="capture" xsi:type="string">PaypercutBnplCaptureCommand</item>
                <item name="void" xsi:type="string">PaypercutBnplVoidCommand</item>
                <item name="refund" xsi:type="string">PaypercutBnplRefundCommand</item>
                <item name="cancel" xsi:type="string">PaypercutBnplVoidCommand</item>
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="PaypercutBnplAuthorizeCommand" type="Magento\Payment\Gateway\Command\GatewayCommand">
        <arguments>
            <argument name="requestBuilder" xsi:type="object">Paypercut\Payment\Gateway\Request\Bnpl\AuthorizationRequest</argument>
            <argument name="handler" xsi:type="object">PaypercutBnplAuthorizationHandler</argument>
            <argument name="transferFactory" xsi:type="object">Paypercut\Payment\Gateway\Http\TransferFactory</argument>
            <argument name="validator" xsi:type="object">Paypercut\Payment\Gateway\Validator\ResponseCodeValidator</argument>
            <argument name="client" xsi:type="object">Paypercut\Payment\Gateway\Http\Client\BnplClient</argument>
        </arguments>
    </virtualType>

    <virtualType name="PaypercutBnplAuthorizationHandler" type="Magento\Payment\Gateway\Response\HandlerChain">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="txnid" xsi:type="string">Paypercut\Payment\Gateway\Response\TxnIdHandler</item>
                <item name="bnpl" xsi:type="string">Paypercut\Payment\Gateway\Response\Bnpl\InstallmentHandler</item>
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="PaypercutBnplCaptureCommand" type="Magento\Payment\Gateway\Command\GatewayCommand">
        <arguments>
            <argument name="requestBuilder" xsi:type="object">Paypercut\Payment\Gateway\Request\Bnpl\CaptureRequest</argument>
            <argument name="handler" xsi:type="object">Paypercut\Payment\Gateway\Response\TxnIdHandler</argument>
            <argument name="transferFactory" xsi:type="object">Paypercut\Payment\Gateway\Http\TransferFactory</argument>
            <argument name="validator" xsi:type="object">Paypercut\Payment\Gateway\Validator\ResponseCodeValidator</argument>
            <argument name="client" xsi:type="object">Paypercut\Payment\Gateway\Http\Client\BnplClient</argument>
        </arguments>
    </virtualType>

    <virtualType name="PaypercutBnplVoidCommand" type="Magento\Payment\Gateway\Command\GatewayCommand">
        <arguments>
            <argument name="requestBuilder" xsi:type="object">Paypercut\Payment\Gateway\Request\VoidRequest</argument>
            <argument name="handler" xsi:type="object">Paypercut\Payment\Gateway\Response\TxnIdHandler</argument>
            <argument name="transferFactory" xsi:type="object">Paypercut\Payment\Gateway\Http\TransferFactory</argument>
            <argument name="validator" xsi:type="object">Paypercut\Payment\Gateway\Validator\ResponseCodeValidator</argument>
            <argument name="client" xsi:type="object">Paypercut\Payment\Gateway\Http\Client\BnplClient</argument>
        </arguments>
    </virtualType>

    <virtualType name="PaypercutBnplRefundCommand" type="Magento\Payment\Gateway\Command\GatewayCommand">
        <arguments>
            <argument name="requestBuilder" xsi:type="object">Paypercut\Payment\Gateway\Request\RefundRequest</argument>
            <argument name="handler" xsi:type="object">Paypercut\Payment\Gateway\Response\TxnIdHandler</argument>
            <argument name="transferFactory" xsi:type="object">Paypercut\Payment\Gateway\Http\TransferFactory</argument>
            <argument name="validator" xsi:type="object">Paypercut\Payment\Gateway\Validator\ResponseCodeValidator</argument>
            <argument name="client" xsi:type="object">Paypercut\Payment\Gateway\Http\Client\BnplClient</argument>
        </arguments>
    </virtualType>

    <type name="Paypercut\Payment\Gateway\Request\Bnpl\AuthorizationRequest">
        <arguments>
            <argument name="config" xsi:type="object">PaypercutBnplConfig</argument>
        </arguments>
    </type>

    <type name="Paypercut\Payment\Gateway\Request\Bnpl\CaptureRequest">
        <arguments>
            <argument name="config" xsi:type="object">PaypercutBnplConfig</argument>
        </arguments>
    </type>

    <type name="Paypercut\Payment\Gateway\Http\Client\BnplClient">
        <arguments>
            <argument name="logger" xsi:type="object">PaypercutLogger</argument>
            <argument name="config" xsi:type="object">PaypercutBnplConfig</argument>
        </arguments>
    </type>

    <!-- BNPL Validators -->
    <virtualType name="PaypercutBnplValidatorPool" type="Magento\Payment\Gateway\Validator\ValidatorPool">
        <arguments>
            <argument name="validators" xsi:type="array">
                <item name="country" xsi:type="string">PaypercutCountryValidator</item>
            </argument>
        </arguments>
    </virtualType>

    <!-- BNPL Value handlers -->
    <virtualType name="PaypercutBnplValueHandlerPool" type="Magento\Payment\Gateway\Config\ValueHandlerPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="default" xsi:type="string">PaypercutBnplConfigValueHandler</item>
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="PaypercutBnplConfigValueHandler" type="Magento\Payment\Gateway\Config\ConfigValueHandler">
        <arguments>
            <argument name="configInterface" xsi:type="object">PaypercutBnplConfig</argument>
        </arguments>
    </virtualType>

    <type name="Paypercut\Payment\Block\BnplInfo" />

    <!-- ==================== SUBSCRIPTIONS ==================== -->

    <!-- Subscription Manager Interface -->
    <preference for="Paypercut\Payment\Api\SubscriptionManagementInterface"
                type="Paypercut\Payment\Model\Subscription\SubscriptionManager"/>

    <!-- Subscription configuration -->
    <virtualType name="PaypercutSubscriptionConfig" type="Magento\Payment\Gateway\Config\Config">
        <arguments>
            <argument name="methodCode" xsi:type="string">paypercut_subscription</argument>
        </arguments>
    </virtualType>

</config>
